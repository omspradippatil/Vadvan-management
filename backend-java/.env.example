# ============================================================================
# Vadhvan Port Management - Java Spring Boot Backend Environment Variables
# Copy this file to .env or set these in your local environment.
# DO NOT COMMIT THE ACTUAL .env FILE!
# ============================================================================

# Application Port
PORT=5000

# Database Connection (Spring Data JPA)
# For local PostgreSQL:
DATABASE_URL=jdbc:postgresql://localhost:5432/vadhvan_port
DB_USERNAME=postgres
DB_PASSWORD=your_local_password

# For Supabase / Cloud Postgres:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.your_supabase_ref
# DB_PASSWORD=your_supabase_password

# JWT Authentication Secret (Must be minimum 32 characters for HMAC-SHA256)
JWT_SECRET=vadhvan-secure-port-fleet-management-jwt-secret-key-32chars
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://vadvan-management.vercel.app
